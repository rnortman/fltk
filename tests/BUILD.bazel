# The pyright-invoking suites all run the tool over fixtures written into a tmpdir with a
# generated pyrightconfig.json whose `extraPaths` is this interpreter's `sys.path`.  So
# whatever a fixture imports has to be a dep of the target, exactly as if the test imported it
# itself: the type-checker resolves imports out of the same runfiles tree.
_PYRIGHT = PYRIGHT_TOOL_DEPS + [":test_support"]

# The compile gates: pytest files that write a throwaway crate with path dependencies on this
# repo and hand it to cargo, because "does the generated Rust compile" needs a Rust compiler
# driver.  They are the one deliberate exception to the all-Bazel rule —
# TODO(bazel-rustc-gate-tests) is the hermetic replacement.
#
# They run unsandboxed — cargo wants a real toolchain, a writable target dir and the registry
# cache in $CARGO_HOME — through the `local` *attribute* rather than the `local` tag, because a
# tag reaches further than the test: tags propagate into every action of the target, including
# the PyCompile of the shared pytest main, whose output path the other 47 targets in this
# package also produce.  The differing action keys are then a conflict Bazel rejects at
# analysis, which is also why the `requires-cargo` tag comes with `precompile = "disabled"`.
# That tag itself is inert — it is there so a lane without a toolchain can filter these out.
#
# The inherited variables are what cargo needs: it lives on PATH under $HOME (rustup), reads the
# registry cache out of $CARGO_HOME, and picks its toolchain through $RUSTUP_HOME plus the
# rust-toolchain.toml in the runfiles root.  $RUSTUP_TOOLCHAIN is deliberately NOT inherited:
# rustup ranks it above the pin file, so inheriting it would let a contributor's ambient
# `RUSTUP_TOOLCHAIN=nightly` compile and clippy the generated code under a different compiler
# than CI, silently.  Bazel scrubs it, so the staged pin governs.  Resolution stays `--offline`,
# so a warm registry cache is a precondition: `cargo fetch --locked` after a fresh clone.
# $HOME also holds the gates' build directories (tests/generated_rust_gate.py's
# cargo_target_dir): the scratch directory Bazel wipes per run would make every gate recompile
# the runtime crates, and all three are invalidated together by //:cargo_workspace_files.
#
# `large` because a cold compile of the generated crate is minutes.
_CARGO_GATE = {
    "env_inherit": [
        "CARGO_HOME",
        "HOME",
        "PATH",
        "RUSTUP_HOME",
    ],
    "local": True,
    "precompile": "disabled",
    "size": "large",
    "tags": ["requires-cargo"],
}

