py_binary(
    name = "rust_gate_gen",
    srcs = ["rust_gate_gen.py"],
    python_version = "3.10",
    deps = [":rust_gate_cases"],
)

genrule(
    name = "rust_gate_srcs",
    outs = ["rust_gate/src/" + path for path in _RUST_GATE_FILES],
    cmd = "$(location :rust_gate_gen) --out-dir $(RULEDIR)/rust_gate/src",
    tools = [":rust_gate_gen"],
)

# Every runtime-crate dep is the :no_python flavor, uniformly: the default flavor carries the
# python-featured fltk-cst-core, so mixing the two puts two distinct fltk_cst_core crates in one
# graph.  make bazel-test names this target in its no-pyo3 cquery sweep.
rust_library(
    name = "rust_gate_lib",
    srcs = [":rust_gate_srcs"],
    crate_features = [],
    crate_name = "fltk_generated_rust_gate",
    crate_root = "rust_gate/src/lib.rs",
    edition = "2021",
    deps = [
        "//crates/fltk-ast-core:no_python",
        "//crates/fltk-cst-core:no_python",
        "//crates/fltk-parser-core:no_python",
        "//crates/fltk-serde-core:no_python",
        # One flavor only, pyo3-free by construction, so there is no :no_python sibling.
        "//crates/fltk-unparser-core",
        "@fltk_crates//:serde",
    ],
)

# `crate =` compiles the library with --test, which is what turns the `#[cfg(test)] mod runtime;`
# modules on.  A generated parser that loops forever is this target's timeout.
rust_test(
    name = "rust_gate_runtime_test",
    crate = ":rust_gate_lib",
)

# The same crate outside `cfg(test)`, which is a different warning surface: a generated binding
# that only a `runtime.rs` uses is dead code in the plain build, and the lint aspect denies
# warnings.  `bazel test //...` builds the library anyway; this is what keeps it covered under
# --build_tests_only, where nothing but a test's own dependencies is built.
build_test(
    name = "rust_gate_build_test",
    targets = [":rust_gate_lib"],
)

# ── Generated CST shapes at the `python` feature set ──────────────────────────
# The gate crate above compiles every case with no features, so each `#[cfg(feature = "python")]`
# item is compiled out there.  These probes compile the same generated file with pyo3 linked,
# the way a Python-extension consumer gets it; see //bzl:python_probe.bzl for what each one
# declares and why the wiring lives in a macro.
#
# prelude: rule names shadowing the std prelude, which no other crate here builds with pyo3.
# span_only: no node children, so the `Shared` import is cfg-gated — this is what makes the gate
# sufficient as well as necessary.
python_feature_probe(
    name = "prelude_python_probe",
    case = "prelude",
)

python_feature_probe(
    name = "span_only_python_probe",
    case = "span_only",
)

