# Files the root package's targets reference across this package boundary.
exports_files([
    "bazel_generated_py_import_check.py",
    "bazel_pytest_main.py",
])

# The .py files in this package, for the root package's ruff and pyright targets: their
# `tests/**/*.py` glob stops at this BUILD file.
#
# The generated protocol module's source path is excluded for the same reason the root package
# excludes the other generated paths — the generator normalizes its own output against the
# pinned config, and a stray in-tree copy must not be linted as if it were hand-written.
filegroup(
    name = "lint_py_srcs",
    srcs = glob(
        ["*.py"],
        exclude = ["rust_parser_fixture_cst_protocol.py"],
    ),
    visibility = ["//:__pkg__"],
)

# Non-test modules the suites import as `tests.<name>`.  They resolve as a namespace package
# from the runfiles root, which //:fltk's `imports = ["."]` already puts on sys.path.
py_library(
    name = "test_support",
    srcs = [
        "cargo_scan.py",
        "fegen_ast_fixture.py",
        "fixture_ast_layer.py",
        "gsm2tree_helpers.py",
        "parser_parity.py",
        "pyright_test_utils.py",
        "retirement_scan.py",
        "tree_paths.py",
        "unparser_parity.py",
        "uv_scan.py",
    ],
    data = [
        # fixture_ast_layer.py reads the fixture grammar, so every suite importing these
        # helpers gets the corpus without naming it.
        "//:fegen_test_data",
        "//tests/rust_parser_fixture:rust_parser_fixture.fltkast",
    ],
    visibility = ["//:__pkg__"],
    deps = [
        ":rust_gate_cases",
        "//:fltk",
        "@pypi//pytest",
    ],
)

# The compile gate's case library, on its own rather than inside :test_support: the code
# generator below is a genrule tool, so everything reachable from it is in that action's key,
# and the action rewrites ~100 .rs files that the largest Rust compile in the tree consumes.
# Through the aggregate that key would cover every helper module and fixture corpus in this
# package, and an edit to any of them would recompile the gate crate.  :test_support depends on
# it, so the suites that import `tests.rust_gate_cases` see no difference.
py_library(
    name = "rust_gate_cases",
    srcs = ["rust_gate_cases.py"],
    visibility = ["//:__pkg__"],
    deps = ["//:fltk"],
)

# The typing-protocol source the rust_parser_fixture extension's .pyi files annotate their
# `node` parameters against.  The compiled fixture supplies the CST and the parsers, so only
# the protocol module is wanted here — hence protocol_only.  It lands in this package because
# the module it must be importable as is `tests.rust_parser_fixture_cst_protocol`.
generate_parser(
    name = "rust_parser_fixture_protocol_py",
    src = "//:fltk/fegen/test_data/rust_parser_fixture.fltkg",
    base_name = "rust_parser_fixture",
    cst_mod_path = "rust_parser_fixture_cst",
    gen_tool = "//:genparser_stage0",
    protocol_only = True,
    visibility = ["//:__pkg__"],
)

_FEGEN_RUST_CST = ["//crates/fegen-rust:fegen_rust_cst"]

