# Target-under-test for the analysistest: instantiates the internal codegen rule
# directly (the only way the analysis-time coupling guard fires; via the public
# macro it is shadowed by the loading-time check) with protocol = True and an
# empty protocol_module, so _generate_rust_srcs_impl fails at analysis time.
#
# The "manual" tag is the standard skylib expect_failure pattern: wildcard
# patterns (//...) skip this intentionally-failing target, while the analysistest
# still analyzes it and captures the failure.
rust_bzl_internals.generate_rust_srcs(
    name = "neg_protocol_without_module",
    src = "dummy.fltkg",
    protocol = True,
    protocol_module = "",
    tags = ["manual"],
)

# Negative target: serde = True with no ast_config. Same "manual" tag rationale
# as above.
rust_bzl_internals.generate_rust_srcs(
    name = "neg_serde_without_config",
    src = "dummy.fltkg",
    serde = True,
    tags = ["manual"],
)

# Negative target: a format_config with unparser = False. Same "manual" tag
# rationale as above.
rust_bzl_internals.generate_rust_srcs(
    name = "neg_format_config_without_unparser",
    src = "dummy.fltkg",
    format_config = "dummy.fltkfmt",
    tags = ["manual"],
)

# Negative target: an out_dir that escapes the package. Same "manual" tag rationale as
# above.
rust_bzl_internals.generate_rust_srcs(
    name = "neg_out_dir_escape",
    src = "dummy.fltkg",
    out_dir = "../escapes",
    tags = ["manual"],
)

# Negative target: parser = False alongside ast, which is generated against the parser module.
# Same "manual" tag rationale as above.
rust_bzl_internals.generate_rust_srcs(
    name = "neg_parser_off_with_ast",
    src = "dummy.fltkg",
    ast = True,
    parser = False,
    tags = ["manual"],
)

# Negative target: a submodules list with no protocol_module, so nothing emits the marker it
# describes. Same "manual" tag rationale as above.
rust_bzl_internals.generate_rust_srcs(
    name = "neg_submodules_without_protocol",
    src = "dummy.fltkg",
    protocol_module = "",
    submodules = [
        "cst",
        "parser",
    ],
    tags = ["manual"],
)

# Target-under-test for the parser = False layout analysistest: the CST-only shape the two
# cst-only fixtures use. "manual" for the same reason as the other codegen targets.
rust_bzl_internals.generate_rust_srcs(
    name = "parser_off_srcs",
    src = "dummy.fltkg",
    parser = False,
    tags = ["manual"],
)

# Target-under-test for the out_dir layout analysistest: every optional generated module is
# enabled, so the test sees all five basenames and can assert none of them stayed behind at
# the default <name>/ subdirectory. "manual" for the same reason as the other codegen
# targets — the test analyzes it and dummy.fltkg is not a grammar the generators accept.
rust_bzl_internals.generate_rust_srcs(
    name = "out_dir_srcs",
    src = "dummy.fltkg",
    ast = True,
    ast_config = "dummy.fltkast",
    format_config = "dummy.fltkfmt",
    out_dir = "gensrc/grammar",
    serde = True,
    tags = ["manual"],
    unparser = True,
)

# Target-under-test for the codegen-argv analysistest: every attr the ast/serde
# actions consume is set, so the test can read them back off the action command
# lines. "manual" keeps it out of wildcard builds — the analysistest only
# analyzes it, and dummy.fltkg is not a grammar these generators would accept.
rust_bzl_internals.generate_rust_srcs(
    name = "argv_ast_serde_srcs",
    src = "dummy.fltkg",
    ast = True,
    ast_config = "dummy.fltkast",
    goal = "nest_sum",
    serde = True,
    tags = ["manual"],
)

# Target-under-test for the unparser-argv analysistest: unparser enabled alongside
# ast and the stub-package knobs, so the test can read back the gen-rust-unparser
# argv, the --unparser-mod-path the ast action gains, and the --submodules list the
# cst action carries. "manual" for the same reason as the other argv targets.
rust_bzl_internals.generate_rust_srcs(
    name = "argv_unparser_srcs",
    src = "dummy.fltkg",
    ast = True,
    extension_name = "argv_unparser",
    format_config = "dummy.fltkfmt",
    protocol_module = "tests.dummy_cst_protocol",
    tags = ["manual"],
    unparser = True,
)

# Target-under-test for the merged-action analysistest: every artifact enabled at once.
# "manual" for the same reason as the other codegen targets.
rust_bzl_internals.generate_rust_srcs(
    name = "argv_merged_srcs",
    src = "dummy.fltkg",
    ast = True,
    ast_config = "dummy.fltkast",
    extension_name = "argv_merged",
    format_config = "dummy.fltkfmt",
    goal = "nest_sum",
    protocol = True,
    protocol_module = "tests.dummy_cst_protocol",
    serde = True,
    tags = ["manual"],
    unparser = True,
)

# Target-under-test for the stub-package analysistests: the hand-assembled-extension shape —
# pure-Rust codegen into the crate's own src/ plus the .pyi stub package, from one action, with
# an explicit submodules list naming a module no codegen target here produces (which is what
# that attribute exists for). "manual" because it is analyzed, not built.
generate_rust_parser(
    name = "argv_stubs",
    src = "dummy.fltkg",
    extension_name = "argv_stubs_ext",
    format_config = "dummy.fltkfmt",
    out_dir = "gensrc",
    protocol_module = "tests.dummy_cst_protocol",
    submodules = [
        "cst",
        "unparser",
        "extra",
    ],
    tags = ["manual"],
    unparser = True,
)

# Target-under-test for the plain-module analysistest: the generate_rust_lib hop
# from the plain_modules attr to the repeatable --plain-module flag. An .rs file
# that reaches a crate's srcs but no `mod` declaration is simply not compiled, so
# no build target can witness this.
generate_rust_lib(
    name = "argv_plain_modules_lib",
    module_name = "argv_plain_modules_lib",
    plain_modules = [
        "ast",
        "de",
    ],
    tags = ["manual"],
)

# Target-under-test for the gen-rust-lib --unparser analysistest. The unparser is a
# registered submodule, so it reaches the crate root through its own flag rather than
# --plain-module; the negative side of that test reuses :argv_plain_modules_lib.
generate_rust_lib(
    name = "argv_unparser_lib",
    module_name = "argv_unparser_lib",
    tags = ["manual"],
    unparser = True,
)

