# In-repo downstream consumer of @fltk.
#
# This is its OWN root Bazel module (not part of the //... graph of the repo root —
# see the root .bazelignore).  It proves what `bazel test //...` in the root cannot:
# that a downstream module can `bazel_dep(name = "fltk")` and load @fltk//:rules.bzl
# and @fltk//:rust.bzl from an external-repo context, composing fltk's own deps
# (rules_rust, rules_python) into its module graph — exactly the Clockwork path.
# Consumed via `make bazel-consumer-check` (cd tests/bazel_consumer && bazel test //...).
module(name = "fltk_consumer_test")

# version = "" because bzlmod ignores the module version under local_path_override.
bazel_dep(name = "fltk", version = "")
local_path_override(
    module_name = "fltk",
    path = "../..",
)

bazel_dep(name = "rules_python", version = "1.5.0")  # py_test + Python toolchain
# 0.73.0 mirrors the root module's dep.  MVS makes the version here inert (fltk's own dep
# already forces it), but the mirror keeps the two modules readable as one pin.
bazel_dep(name = "rules_rust", version = "0.73.0")   # rust extension for the toolchain pin

# Test-only: build_test states the AST codegen target's coverage as a test rather than
# leaving it to `bazel test //...` incidentally building it.  dev_dependency = True because
# nothing this module exports carries skylib into another module graph.
bazel_dep(name = "bazel_skylib", version = "1.8.2", dev_dependency = True)

# DELIBERATELY NOT fltk's own interpreter pin.  fltk's generator binaries carry
# python_version because a consumer's default otherwise wins and the cp310-only wheels in
# @pypi have no matching distribution; with this default equal to that pin, the attributes
# could all be deleted and this lane would stay green.  A version fltk does not pin is what
# makes the lane falsify: //:fltk carries no @pypi deps, so this module's own py_tests run at
# any version, while the generator tools invoked by generate_parser / generate_rust_parser
# fail analysis here the moment one of them stops naming its version.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Rust toolchain for this consumer workspace.  As a root module it selects its own
# toolchain; it mirrors the same 1.97.1 pin as the fltk root module rather than riding
# the rules_rust default, so all of `make check` compiles Rust with one compiler.
#
# MUST match the versions tag in ../../MODULE.bazel, which is the single Rust version pin
# for the repo.  `make bazel-toolchain-guard` fails the build if this mirror drifts.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.97.1"],
)

# This module's own crate hub, holding serde and nothing else.  It is what
# //crates/fltk-serde-core:serde is pointed at in .bazelrc, and being a hub distinct from
# @fltk_crates is the whole content of the assertion: the pure-Rust serde consumer
# (//:consumer_serde) derives Deserialize from this serde and hands values through
# fltk-serde-core, which only compiles if the flag reached it.
#
# Declared as a spec rather than read out of a Cargo manifest: this module has no manifest
# and neither does fltk.  The resolution is pinned by the tracked lockfile below — without it
# `from_specs` would re-resolve the semver range at fetch time, so a new serde release would
# change what `make bazel-consumer-check` compiles on an unchanged commit.  Repin with
# `CARGO_BAZEL_REPIN=1 bazel test //...` from this directory; `make check-bazel-locks` diffs
# the result.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    features = ["derive"],
    package = "serde",
    version = "1",
)
crate.from_specs(
    name = "consumer_crates",
    cargo_lockfile = "//:cargo-bazel-resolved.lock",
    lockfile = "//:cargo-bazel-lock.json",
)
use_repo(crate, "consumer_crates")

# ---------------------------------------------------------------------------
# Hermetic C toolchain for the glibc platform (the default and exec platform)
# ---------------------------------------------------------------------------
# Every Rustc action key contains two products of the C toolchain: rules_rust's
# `process_wrapper` binary (built in the exec configuration and linked with the
# cc toolchain's linker) and the toolchain's builtin include directory list.
# With Bazel's auto-detected host gcc both differ between machines, and even
# between gcc point releases, so two hosts sharing a remote cache get no hits
# from each other. A pinned LLVM release plus a pinned Debian sysroot makes
# both byte-identical on every machine. Same block as brenn's MODULE.bazel.
#
# The sysroot is Chromium's bullseye amd64 sysroot (glibc 2.31): binaries link
# against it and run on any newer glibc. `cxx_include_layout = debian` tells
# the toolchain where that sysroot keeps libstdc++ and the gcc runtime.
#
# `dev_dependency`: registration is unconditional, and a dependent module
# brings its own.
bazel_dep(name = "toolchains_llvm", version = "1.9.0", dev_dependency = True)

sysroot = use_repo_rule("@toolchains_llvm//toolchain:sysroot.bzl", "sysroot")
sysroot(
    name = "org_chromium_sysroot_linux_x64",
    dev_dependency = True,
    sha256 = "52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d",
    # Chromium serves each sysroot tarball under its own sha256, no filename.
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d"],
)

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    name = "llvm_toolchain",
    cxx_include_layout = {"linux-x86_64": "debian"},
    llvm_version = "22.1.8",
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@org_chromium_sysroot_linux_x64//sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all", dev_dependency = True)
