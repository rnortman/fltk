# Downstream-consumer smoke targets.  Every load below uses the cross-module @fltk//
# path a real consumer uses, NOT the same-repo // path the root BUILD.bazel uses —
# that difference is the whole point of this module.
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@fltk//:rules.bzl", "generate_parser")
load("@fltk//:rust.bzl", "fltk_pyo3_cdylib", "generate_rust_parser")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# ── Python-parser path ────────────────────────────────────────────────────────
# Pure-Python path: no @fltk//:native_py dependency.
generate_parser(
    name = "consumer_py_srcs",
    src = "consumer.fltkg",
    base_name = "consumer",
    cst_mod_path = "consumer_cst",
)

py_library(
    name = "consumer_py_parser",
    srcs = [":consumer_py_srcs"],
    # imports = ["."] so the generated modules resolve as top-level imports.
    imports = ["."],
    deps = ["@fltk"],
)

py_test(
    name = "consumer_python_test",
    srcs = ["consumer_python_test.py"],
    deps = [
        ":consumer_py_parser",
        "@fltk",
    ],
)

# ── Rust-extension path ───────────────────────────────────────────────────────
# Exercises the cross-module cdylib build; fltk_pyo3_cdylib must remain exported
# from @fltk//:rust.bzl.
#
# The sibling macro pyo3_extension_py_library — wrapping a cdylib the consumer compiled
# itself — has no target here, because a hand-assembled cdylib needs a direct pyo3 dep and
# this module has no way to name the pyo3 instance @fltk//crates/fltk-cst-core links.
# TODO(bazel-consumer-pyo3-seam).
generate_rust_parser(
    name = "consumer_rs_srcs",
    src = "consumer.fltkg",
)

fltk_pyo3_cdylib(
    name = "consumer_native",
    rs_srcs = ":consumer_rs_srcs",
)

py_test(
    name = "consumer_rust_test",
    srcs = ["consumer_rust_test.py"],
    deps = [":consumer_native"],
)

# ── CST-only path ─────────────────────────────────────────────────────────────
# A pure-Rust consumer whose crate compiles the CST and nothing else: `parser = False` drops
# the grammar's largest generated artifact for a crate that never parses (it consumes CSTs
# built elsewhere).  Declared here because the attribute is public consumer surface and its
# in-repo uses are all same-repo `//` loads, which resolve differently from this module's
# `@fltk//` one.
generate_rust_parser(
    name = "consumer_cst_only_srcs",
    src = "consumer.fltkg",
    out_dir = "consumer_cst_crate",
    parser = False,
)

rust_library(
    name = "consumer_cst_only",
    srcs = glob(["consumer_cst_crate/**/*.rs"]) + [":consumer_cst_only_srcs"],
    crate_name = "consumer_cst_only",
    crate_root = "consumer_cst_crate/lib.rs",
    edition = "2021",
    deps = ["@fltk//crates/fltk-cst-core:no_python"],
)

build_test(
    name = "consumer_cst_only_build_test",
    targets = [":consumer_cst_only"],
)

# ── AST path ──────────────────────────────────────────────────────────────────
# A consumer generating a Rust AST through the macro's ast attrs and compiling it against
# @fltk//crates/fltk-ast-core.  The wide scalar builtins are the point: `type: uuid` and
# `type: decimal` make the emitted module name ::fltk_ast_core::Uuid and
# ::fltk_ast_core::Decimal, which resolve only when that target enables its "uuid" and
# "decimal" features — so this crate failing to compile is how a regression in the runtime
# target's feature list surfaces.
generate_rust_parser(
    name = "consumer_ast_srcs",
    src = "consumer_ast.fltkg",
    ast = True,
    ast_config = "consumer_ast.fltkast",
    out_dir = "consumer_ast_crate",
)

# The :no_python flavor of every runtime crate: this target is the pure-Rust consumer
# configuration, and `make bazel-consumer-check` asserts pyo3 is absent from its graph.
rust_library(
    name = "consumer_ast",
    srcs = glob(["consumer_ast_crate/**/*.rs"]) + [":consumer_ast_srcs"],
    crate_name = "consumer_ast",
    crate_root = "consumer_ast_crate/lib.rs",
    edition = "2021",
    deps = [
        "@fltk//crates/fltk-ast-core:no_python",
        "@fltk//crates/fltk-cst-core:no_python",
        "@fltk//crates/fltk-parser-core:no_python",
    ],
)

# `bazel test //...` builds every matched target, but a library that is nobody's dependency
# is easy to drop by accident; this states the coverage as a test.
build_test(
    name = "consumer_ast_build_test",
    targets = [":consumer_ast"],
)

# ── pure-Rust unparser + formatter path ───────────────────────────────────────
# A consumer whose deliverable is a formatter: generated unparser.rs with a .fltkfmt spec
# baked in, linked against @fltk//crates/fltk-unparser-core, plus a binary built from
# @fltk//crates/fltk-fmt-cli.  Nothing here touches Python or pyo3.
#
# ast = True is here because ast + unparser is the combination that makes the AST module
# `use super::unparser;` and emit unparse_str, and this is the only Bazel target that
# compiles it.  Without it the sibling-module path reaches the generator (an analysistest
# pins that) but nothing ever checks the generated import resolves at the layout out_dir
# produced.
generate_rust_parser(
    name = "consumer_fmt_srcs",
    src = "consumer_unparser.fltkg",
    ast = True,
    format_config = "consumer_unparser.fltkfmt",
    out_dir = "consumer_fmt_crate",
    unparser = True,
)

rust_library(
    name = "consumer_fmt",
    srcs = glob(["consumer_fmt_crate/**/*.rs"]) + [":consumer_fmt_srcs"],
    crate_name = "consumer_fmt",
    crate_root = "consumer_fmt_crate/lib.rs",
    edition = "2021",
    deps = [
        "@fltk//crates/fltk-ast-core:no_python",
        "@fltk//crates/fltk-cst-core:no_python",
        "@fltk//crates/fltk-parser-core:no_python",
        "@fltk//crates/fltk-unparser-core",
    ],
)

rust_test(
    name = "consumer_fmt_test",
    crate = ":consumer_fmt",
)

rust_binary(
    name = "consumer_fmt_bin",
    srcs = ["consumer_fmt_main.rs"],
    edition = "2021",
    deps = [
        ":consumer_fmt",
        "@fltk//crates/fltk-fmt-cli",
    ],
)

# End-to-end run of the formatter binary: the library test covers the render path, this
# covers the CLI scaffolding around it (argument handling, file input, stdout output),
# which is the part a consumer gets from fltk rather than from their own code.
genrule(
    name = "consumer_fmt_actual",
    srcs = ["consumer_fmt_input.txt"],
    outs = ["consumer_fmt_actual.txt"],
    cmd = "$(location :consumer_fmt_bin) $(location consumer_fmt_input.txt) > $@",
    tools = [":consumer_fmt_bin"],
)

# consumer_fmt_expected.txt has no trailing newline: the CLI writes exactly what the
# renderer produced, and the comparison is byte-exact on purpose — a formatter silently
# gaining or losing a trailing byte is a real change to a consumer's diffs.
diff_test(
    name = "consumer_fmt_cli_test",
    file1 = ":consumer_fmt_actual",
    file2 = "consumer_fmt_expected.txt",
)

# ── extension-mode unparser path ──────────────────────────────────────────────
# The same unparser through the Python-extension mode: the generated crate root must
# declare and register `mod unparser;` and the cdylib must link fltk-unparser-core, or the
# submodule is missing at import time with no build-time complaint.
generate_rust_parser(
    name = "consumer_unparser_native",
    src = "consumer_unparser.fltkg",
    format_config = "consumer_unparser.fltkfmt",
    python_extension = True,
    unparser = True,
)

py_test(
    name = "consumer_unparser_test",
    srcs = ["consumer_unparser_test.py"],
    deps = [":consumer_unparser_native"],
)

# ── serde path ────────────────────────────────────────────────────────────────
# The serde frontend across the module boundary, in both codegen modes. Each links the serde
# this module's .bazelrc points //crates/fltk-serde-core:serde at (@consumer_crates//:serde,
# a hub distinct from fltk's own), so both are also the coverage for the injection seam.
#
# First, extension mode: ast.rs + de.rs compiled into a cdylib.
generate_rust_parser(
    name = "consumer_serde_native",
    src = "consumer_ast.fltkg",
    ast = True,
    ast_config = "consumer_ast.fltkast",
    python_extension = True,
    serde = True,
)

build_test(
    name = "consumer_serde_build_test",
    targets = [":consumer_serde_native"],
)

# Then the pure-Rust mode, the configuration the injection seam exists for: no ast = True, so
# the only typed surface is the hand-written model in consumer_serde_crate/lib.rs, whose
# derives come from @consumer_crates//:serde. That crate compiles only if fltk-serde-core was
# compiled against the same instance — so the seam being wired is not asserted by a query
# here, it is what makes this target build at all.
generate_rust_parser(
    name = "consumer_serde_srcs",
    src = "consumer_ast.fltkg",
    ast_config = "consumer_ast.fltkast",
    goal = "payment",
    out_dir = "consumer_serde_crate",
    serde = True,
)

rust_library(
    name = "consumer_serde",
    srcs = glob(["consumer_serde_crate/**/*.rs"]) + [":consumer_serde_srcs"],
    crate_name = "consumer_serde",
    crate_root = "consumer_serde_crate/lib.rs",
    edition = "2021",
    deps = [
        "@consumer_crates//:serde",
        "@fltk//crates/fltk-cst-core:no_python",
        "@fltk//crates/fltk-parser-core:no_python",
        "@fltk//crates/fltk-serde-core:no_python",
    ],
)

rust_test(
    name = "consumer_serde_test",
    crate = ":consumer_serde",
)
