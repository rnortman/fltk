# Downstream-consumer smoke targets.  Every load below uses the cross-module @fltk//
# path a real consumer uses, NOT the same-repo // path the root BUILD.bazel uses —
# that difference is the whole point of this module.
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@fltk//:rules.bzl", "generate_parser")
load("@fltk//:rust.bzl", "fltk_pyo3_cdylib", "generate_rust_parser")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")

# ── Python-parser path ────────────────────────────────────────────────────────
# Pure-Python path: no @fltk//:native_py dependency.
generate_parser(
    name = "consumer_py_srcs",
    src = "consumer.fltkg",
    base_name = "consumer",
    cst_mod_path = "consumer_cst",
)

py_library(
    name = "consumer_py_parser",
    srcs = [":consumer_py_srcs"],
    # imports = ["."] so the generated modules resolve as top-level imports.
    imports = ["."],
    deps = ["@fltk"],
)

py_test(
    name = "consumer_python_test",
    srcs = ["consumer_python_test.py"],
    deps = [
        ":consumer_py_parser",
        "@fltk",
    ],
)

# ── Rust-extension path ───────────────────────────────────────────────────────
# Exercises the cross-module cdylib build; fltk_pyo3_cdylib must remain exported
# from @fltk//:rust.bzl.
generate_rust_parser(
    name = "consumer_rs_srcs",
    src = "consumer.fltkg",
)

fltk_pyo3_cdylib(
    name = "consumer_native",
    rs_srcs = ":consumer_rs_srcs",
)

py_test(
    name = "consumer_rust_test",
    srcs = ["consumer_rust_test.py"],
    deps = [":consumer_native"],
)

# ── AST path ──────────────────────────────────────────────────────────────────
# A consumer generating a Rust AST through the macro's ast attrs and compiling it against
# @fltk//crates/fltk-ast-core.  The wide scalar builtins are the point: `type: uuid` and
# `type: decimal` make the emitted module name ::fltk_ast_core::Uuid and
# ::fltk_ast_core::Decimal, which resolve only when that target enables its "uuid" and
# "decimal" features — so this crate failing to compile is how a regression in the runtime
# target's feature list surfaces.
generate_rust_parser(
    name = "consumer_ast_srcs",
    src = "consumer_ast.fltkg",
    ast = True,
    ast_config = "consumer_ast.fltkast",
)

# The generated modules are siblings (super::cst, super::parser) and must sit
# next to the hand-authored crate root, hence the copy into one directory.
genrule(
    name = "consumer_ast_crate_srcs",
    srcs = [
        "consumer_ast_lib.rs",
        ":consumer_ast_srcs",
    ],
    outs = [
        "consumer_ast_crate/ast.rs",
        "consumer_ast_crate/cst.rs",
        "consumer_ast_crate/lib.rs",
        "consumer_ast_crate/parser.rs",
    ],
    cmd = """
        OUTDIR=$$(dirname $(execpath consumer_ast_crate/lib.rs))
        cp $(execpath consumer_ast_lib.rs) $$OUTDIR/lib.rs
        for f in $(locations :consumer_ast_srcs); do
            cp $$f $$OUTDIR/$$(basename $$f)
        done
    """,
)

rust_library(
    name = "consumer_ast",
    srcs = [":consumer_ast_crate_srcs"],
    crate_name = "consumer_ast",
    crate_root = "consumer_ast_crate/lib.rs",
    edition = "2021",
    deps = [
        "@fltk//crates/fltk-ast-core",
        "@fltk//crates/fltk-cst-core",
        "@fltk//crates/fltk-parser-core",
    ],
)

# `bazel test //...` builds every matched target, but a library that is nobody's dependency
# is easy to drop by accident; this states the coverage as a test.
build_test(
    name = "consumer_ast_build_test",
    targets = [":consumer_ast"],
)

# ── serde path ────────────────────────────────────────────────────────────────
# The serde frontend across the module boundary: ast.rs + de.rs compiled into a
# cdylib.  Uses python_extension mode because `serde` lives in fltk's module-private
# crate hub, which a downstream module cannot name directly.
generate_rust_parser(
    name = "consumer_serde_native",
    src = "consumer_ast.fltkg",
    ast = True,
    ast_config = "consumer_ast.fltkast",
    python_extension = True,
    serde = True,
)

build_test(
    name = "consumer_serde_build_test",
    targets = [":consumer_serde_native"],
)
