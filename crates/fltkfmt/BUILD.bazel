load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//bzl:cargo_probe.bzl", "cargo_file_probe")
load("//bzl:version.bzl", "FLTK_CRATE_VERSION")

# pyo3 must be absent from this target's graph (the cquery loop in `make bazel-test` asserts it),
# which is why the fegen dependency is the `:no_python` flavor.
rust_binary(
    name = "fltkfmt",
    srcs = ["src/main.rs"],
    edition = "2021",
    # What `fltkfmt --version` prints.
    version = FLTK_CRATE_VERSION,
    visibility = ["//visibility:public"],
    deps = [
        "//crates/fegen-rust:no_python",
        "//crates/fltk-fmt-cli",
    ],
)

# The tests spawn the built binary and format a corpus of real grammars, so the binary, the
# corpus and the golden fixture are all data.
#
# FLTKFMT_TEST_ROOT is "." because the corpus data lands at its workspace-relative paths in
# the runfiles tree (the test's working directory).
rust_test(
    name = "cli_test",
    srcs = ["tests/cli.rs"],
    data = [
        "tests/golden/fegen.fltkg.golden",
        "//:fltkfmt_corpus",
        ":fltkfmt",
    ],
    edition = "2021",
    env = {
        "FLTKFMT_BIN": "$(rootpath :fltkfmt)",
        "FLTKFMT_TEST_ROOT": ".",
        "FLTKFMT_VERSION": FLTK_CRATE_VERSION,
    },
)

# The formatter guide's worked example is held to this invocation by //tests:test_doc_guide_cli_examples.
exports_files(
    ["src/main.rs"],
    visibility = ["//tests:__pkg__"],
)

# This package's half of the Cargo retirement gate's declaration probe.
cargo_file_probe()
