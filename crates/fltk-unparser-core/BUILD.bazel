load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Runtime for the generated unparser.rs. No features, no dependencies (see
# Cargo.toml): pyo3-free by construction, safe for both pure-Rust and cdylib consumers.
rust_library(
    name = "fltk-unparser-core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fltk_unparser_core",
    edition = "2021",
    visibility = ["//visibility:public"],
)

# One flavor (pyo3-free by construction), so no flavor choice to make.
rust_test(
    name = "fltk-unparser-core_test",
    crate = ":fltk-unparser-core",
)
