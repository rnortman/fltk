# The single Python dependency manifest for fltk.
#
# Compiled to requirements_lock.txt by `bazel run //:requirements.update`, which is the
# ONLY writer of that file; the `//:requirements.test` target (part of `bazel test //...`)
# fails when the two drift.  Never hand-edit requirements_lock.txt.
#
# The lock feeds pip.parse's `pypi` hub in MODULE.bazel, so everything listed here is
# resolvable as `@pypi//<name>`.  Runtime consumers of //:fltk only ever reach the runtime
# block; the tool/test packages are referenced solely by test and lint targets.

# ── Runtime ───────────────────────────────────────────────────────────────────
astor
typer

# LSP servers (fltk-lsp / fltk-grammar-lsp).  Not a dep of //:fltk itself — only of the
# LSP entry-point targets — but it ships in the hub so those targets can resolve it.
pygls>=2,<3

# ── Test ──────────────────────────────────────────────────────────────────────
pytest
pytest-lsp
coverage[toml]>=6.5
# tomllib is stdlib from 3.11; the manifest-reading guards (tests/test_pyright_config_mirror.py,
# tests/test_ast_core_manifest.py, tests/test_cargo_workspace_files.py) have to parse TOML on
# the 3.10 floor rather than skip there.
tomli>=2; python_version < '3.11'

# ── Lint / typecheck ──────────────────────────────────────────────────────────
# One ruff for the whole repo: codegen normalization uses the same binary as
# //:ruff_check / //:ruff_format_check / //:ruff_fix, so what a generator emits and what
# the gate accepts cannot disagree.  The exact version is whatever requirements_lock.txt
# pins; a bump changes generated bytes, which tests/test_seed_fixed_point.py reports.
ruff
# The `nodejs` extra bundles a Node runtime in the wheel; without it pyright downloads
# one on first run, which a Bazel action cannot do.
pyright[nodejs]
