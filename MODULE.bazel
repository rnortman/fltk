module(
    name = "fltk",
)

bazel_dep(name = "rules_python", version = "1.5.0")
# 0.73.0 is not free-floating: crate_universe's checked-in lockfile below carries a digest
# of the rules_rust version that computed it, so the declared version has to be the one a
# consumer selects, or every consumer build re-resolves. Bumping it repins those locks.
bazel_dep(name = "rules_rust", version = "0.73.0")

# Test-only: the skylib unittest/analysistest harness backs //tests/bazel_rules'
# regression coverage of generate_rust_parser's misconfiguration guards.
# dev_dependency = True keeps skylib out of downstream consumers' module graphs;
# rust.bzl / rules.bzl (the files consumers load) must never load skylib.
bazel_dep(name = "bazel_skylib", version = "1.8.2", dev_dependency = True)

# Rust toolchain.  This tag is the single Rust version pin for the whole repo: there is
# no host toolchain to pin, so nothing mirrors a TOML file anymore.  Without the tag
# rules_rust supplies its own default version, which changes the compiler under an
# unchanged commit.  Every other Bazel module in the tree that uses rules_rust must
# carry the same version; `make bazel-toolchain-guard` derives the mirror list from the
# tracked MODULE.bazel files and fails when one drifts or omits the tag.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.97.1"],
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

# configure_coverage_tool wires rules_python's coverage.py into every py_test, so
# `bazel coverage //...` collects the Python suite.  The [tool.coverage] settings in
# pyproject.toml still apply.
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = "3.10",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.10",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pypi")

# Third-party Rust dependencies (pyo3, regex-automata, indexmap, serde, and transitive graph).
# This hub is module-private: FLTK's macros reference it as internal labels.
# Clockwork and other consumers do NOT need a use_repo for this hub.  A pure-Rust consumer
# using the serde frontend resolves the runtime crates in their OWN crate hub instead, so
# that fltk-serde-core and their #[derive(Deserialize)] structs share one serde instance;
# docs/bazel-consumer-guide.md carries that recipe and the rest of the consumer surface.
#
# The specs below are the whole dependency declaration for this repo's Rust code: there is no
# Cargo manifest anywhere in the tree, so a crate an in-tree BUILD file names must appear here
# and nowhere else.  Feature sets are stated per spec because crate_universe does not read
# Cargo defaults for a spec's dependents: what a `crate_features` list in a BUILD file turns on
# is this crate's *own* features, while a third-party crate's features are fixed here.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# pyo3 and regex-automata carry exact pins: both shape generated-code behavior (the pyclass
# ABI surface the extensions link, and the regex dialect a generated parser's terminals are
# compiled with), so a patch release must be a deliberate edit rather than a repin side effect.
#
# `extension-module` is on because every cdylib in the tree sets it; the hub unifies pyo3's
# features across the graph, which is what lets the rlib-only targets (//tests:prelude_python_probe,
# //crates/fltk-cst-core:python_test) build and run without linking an interpreter.
crate.spec(
    features = [
        "abi3-py310",
        "extension-module",
    ],
    package = "pyo3",
    version = "=0.29.0",
)

# Single writer for the regex engine.  fltk-parser-core compiles a grammar's terminals for
# anchored prefix matching and fltk-ast-core compiles the same terminals for full-match
# validation and for the anchored prefix matching that replays a terminal-only rule's parse
# when rebuilding its CST, so the two must agree on version *and* feature set: a pattern the generated
# parser accepts has to compile in the AST layer too.  This one spec is that agreement.
crate.spec(
    default_features = False,
    features = [
        "dfa-onepass",
        "hybrid",
        "meta",
        "nfa-backtrack",
        "nfa-pikevm",
        "perf",
        "std",
        "syntax",
        "unicode",
    ],
    package = "regex-automata",
    version = "=0.4.16",
)

# The container a `key:` keyed collection generates (fltk-ast-core).
crate.spec(
    package = "indexmap",
    version = "2",
)

# The two `type:` scalar builtins, both without default features: uuid's generators and
# rust_decimal's serde support are no part of parsing a lexeme or rendering a value back to one.
crate.spec(
    default_features = False,
    features = ["std"],
    package = "uuid",
    version = "1",
)

crate.spec(
    default_features = False,
    features = ["std"],
    package = "rust_decimal",
    version = "1",
)

# fltk-serde-core's own dependency, and the default instance a consumer's
# //crates/fltk-serde-core:serde flag replaces.  `derive` because the consumer-side half of
# the serde frontend is a #[derive(Deserialize)] struct that must share this instance.
crate.spec(
    features = ["derive"],
    package = "serde",
    version = "1",
)

# A foreign Deserializer for fltk-serde-core's unit tests: the wrapper types must fail loudly
# under a real second implementation rather than degrade.
crate.spec(
    package = "serde_json",
    version = "1",
)

# The argument parser fltk-fmt-cli builds a formatter binary's CLI from.
crate.spec(
    features = ["derive"],
    package = "clap",
    version = "4",
)

# `lockfile` is not optional, even though repinning happens here: rules_rust
# refuses a crate_universe extension call in a NON-root module without one,
# because repinning cannot cross a module boundary.  A consumer that pulls fltk
# in as a bazel_dep hits that refusal, so the resolution is checked in and
# repinned here with `CARGO_BAZEL_REPIN=1 bazel build //...` whenever a spec above
# changes.  `make check-bazel-locks` diffs the result, so a repin cannot be left
# uncommitted.  Repinning uses the cargo binary inside rules_rust's hermetic
# toolchain — no host cargo and no rustup.
#
# `cargo_lockfile` names a second tracked artifact, `cargo-bazel-resolved.lock`: the
# Cargo-lock-format resolution cargo-bazel writes during a repin and reads on every other
# build.  It is not optional — without it the non-repinning path of the extension passes a
# null path to the generator — and it is not a cargo input: nothing in the tree declares a
# package, so no cargo invocation can consume it.  Both files are written by the same repin
# and diffed by `make check-bazel-locks`.
crate.from_specs(
    name = "fltk_crates",
    cargo_lockfile = "//:cargo-bazel-resolved.lock",
    lockfile = "//:cargo-bazel-lock.json",
)
use_repo(crate, "fltk_crates")

# ---------------------------------------------------------------------------
# Hermetic C toolchain for the glibc platform (the default and exec platform)
# ---------------------------------------------------------------------------
# Every Rustc action key contains two products of the C toolchain: rules_rust's
# `process_wrapper` binary (built in the exec configuration and linked with the
# cc toolchain's linker) and the toolchain's builtin include directory list.
# With Bazel's auto-detected host gcc both differ between machines, and even
# between gcc point releases, so two hosts sharing a remote cache get no hits
# from each other. A pinned LLVM release plus a pinned Debian sysroot makes
# both byte-identical on every machine. Same block as brenn's MODULE.bazel.
#
# The sysroot is Chromium's bullseye amd64 sysroot (glibc 2.31): binaries link
# against it and run on any newer glibc. `cxx_include_layout = debian` tells
# the toolchain where that sysroot keeps libstdc++ and the gcc runtime.
#
# `dev_dependency`: registration is unconditional, and a dependent module
# brings its own.
bazel_dep(name = "toolchains_llvm", version = "1.9.0", dev_dependency = True)

sysroot = use_repo_rule("@toolchains_llvm//toolchain:sysroot.bzl", "sysroot")
sysroot(
    name = "org_chromium_sysroot_linux_x64",
    dev_dependency = True,
    sha256 = "52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d",
    # Chromium serves each sysroot tarball under its own sha256, no filename.
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d"],
)

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    name = "llvm_toolchain",
    cxx_include_layout = {"linux-x86_64": "debian"},
    llvm_version = "22.1.8",
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@org_chromium_sysroot_linux_x64//sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all", dev_dependency = True)
