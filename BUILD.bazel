# ── Python dependency lock ────────────────────────────────────────────────────
# Single writer for requirements_lock.txt: `bazel run //:requirements.update`.
compile_pip_requirements(
    name = "requirements",
    src = "requirements.in",
    requirements_txt = "requirements_lock.txt",
    tags = ["requires-network"],
)

# Source paths of the generated modules.  Nothing in git occupies them — they are produced by
# the :*_py targets below — and the globs that build :fltk_src and the lint targets exclude them
# anyway, defensively: an ad-hoc `bazel run //:genparser` aimed at the source tree can leave an
# in-tree copy behind.  Without the exclude that stale copy would be picked up ahead of the
# generated output, and the build would be green against code no grammar produces.
#
# The four seed files (fltk_cst, fltk_cst_protocol, fltk_parser, fltk_trivia_parser) are
# deliberately absent: they are the committed self-hosting seed, and :fltk_src is exactly what
# a generator may import.
_GENERATED_PY = GENERATED_PY

_GENERATED_PY_TARGETS = GENERATED_PY_TARGETS

# ── Lint ──────────────────────────────────────────────────────────────────────
# Everything here is inert unless --//bzl:lint is set (the `lint` config in .bazelrc sets
# it), so `bazel build //...` stays a build and `bazel build --config lint //...` is the
# gate.  See //bzl:py_lint.bzl.

# The hand-written sources.  Generated modules are out of scope for ruff: the generator
# normalizes its own output against the same pinned config, so a finding here could only ever
# be a lint rule the generator does not satisfy, reported at a file nobody edits.  pyright
# still type-checks them — it takes the Bazel-generated copies, below.
#
# tests/bazel_consumer is absent because it is .bazelignore'd — see
# TODO(bazel-lint-consumer-module).
#
# tests/ is its own package (it holds the per-file py_tests), so the glob below stops at its
# BUILD file and //tests:lint_py_srcs carries that directory's files instead.
_LINT_PY_SRCS = glob(
    [
        "*.py",
        "fltk/**/*.py",
        "fltk/**/*.pyi",
        "examples/**/*.py",
    ],
    exclude = _GENERATED_PY,
    allow_empty = False,
) + ["//tests:lint_py_srcs"]

_RUFF_CONFIG_DEPS = ["gencode-ruff.toml"]

ruff_lint(
    name = "ruff_check",
    srcs = _LINT_PY_SRCS,
    config = "pyproject.toml",
    config_deps = _RUFF_CONFIG_DEPS,
    mode = "check",
)

ruff_lint(
    name = "ruff_format_check",
    srcs = _LINT_PY_SRCS,
    config = "pyproject.toml",
    config_deps = _RUFF_CONFIG_DEPS,
    mode = "format",
)

ruff_fix(
    name = "ruff_fix",
)

# Whole-program type check.  include/exclude/extraPaths/pythonVersion mirror the
# [tool.pyright] table in pyproject.toml; venvPath has no successor — third-party imports
# resolve through the deps below instead of through a virtualenv.
#
# The generated modules staged here are the Bazel-generated copies, not the committed ones:
# they carry the same short_paths, so they land at their package paths beside the hand-written
# sources, and what gets type-checked is what //:fltk actually ships.
pyright_lint(
    name = "pyright",
    srcs = _LINT_PY_SRCS + glob(["fltk/**/*.typed"]) + _GENERATED_PY_TARGETS + [
        "//crates/fegen-rust:fegen_rust_cst_stub_srcs",
        "//tests:rust_parser_fixture_protocol_py",
    ],
    exclude = ["**/__pycache__"],
    # The fegen_rust_cst stub package is a Bazel output staged at its own package path, so the
    # search-path entry is the directory that holds it rather than a tree in git.
    extra_paths = ["crates/fegen-rust"],
    include = [
        "fltk",
        "*.py",
        "tests/typecheck_fegen_cst_conformance.py",
    ],
    deps = [
        "@pypi//astor",
        "@pypi//coverage",
        "@pypi//pygls",
        "@pypi//pytest",
        "@pypi//pytest_lsp",
        "@pypi//ruff",
        "@pypi//typer",
    ],
)

# Generation normalizes its own output, so every generator binary carries the ruff wheel and
# the pinned config.  See //bzl:gencode_tool.bzl and fltk/fegen/gencode_format.py.

# `python_version` is explicit on every public py_binary here: the module-level
# `python.toolchain(is_default = True, python_version = "3.10")` in MODULE.bazel is honored
# only when fltk is the root module.  A downstream consumer's own default wins otherwise, and
# the cp310-only wheels in @pypi then have no matching distribution — an analysis failure in
# the consumer's build, at a target the consumer never named.
py_binary(
    name = "genparser",
    srcs = ["fltk/fegen/genparser.py"],
    data = GENCODE_TOOL_DATA,
    python_version = "3.10",
    visibility = ["//visibility:public"],
    deps = [
        ":fltk",
        "@pypi//astor",
        "@pypi//typer",
    ] + GENCODE_TOOL_DEPS,
)

# Stage-0 generator: the `generate` command over the Python backend alone.
#
# :genparser cannot generate the aux Python modules, because the Rust-backend generators it
# also carries import them at module level (gsm2parser_rs -> regex_parser, ast_config ->
# fltkast_parser, plumbing -> unparsefmt_parser + fltklsp_parser).  This binary depends on
# :fltk_src, which excludes every generated module, so the cycle cannot close.  Pass it as
# generate_parser(gen_tool = ...) for those grammars.
py_binary(
    name = "genparser_stage0",
    srcs = ["fltk/fegen/genparser_stage0.py"],
    data = GENCODE_TOOL_DATA,
    main = "fltk/fegen/genparser_stage0.py",
    python_version = "3.10",
    visibility = ["//visibility:public"],
    deps = [
        ":fltk_src",
        "@pypi//astor",
        "@pypi//typer",
    ] + GENCODE_TOOL_DEPS,
)

# `bazel run //:regen_seed` — the only regeneration entry point that writes into the source
# tree.  It refreshes the four committed seed modules from fegen.fltkg; run it after editing
# fegen.fltkg or a Python-backend generator, and commit the result.  //tests/test_seed_fixed_point.py
# is the gate that fails when the committed seed and this target's output disagree.
#
# :genparser_stage0 rather than :genparser: the seed is pure Python-backend output, and the
# stage-0 binary is the one whose imports are guaranteed not to reach a generated module.
regen_seed(
    name = "regen_seed",
    base_name = "fltk",
    cst_mod_path = "fltk.fegen.fltk_cst",
    gen_tool = ":genparser_stage0",
    grammar = "fltk/fegen/fegen.fltkg",
    out_dir = "fltk/fegen",
)

# ── Runtime CLIs ──────────────────────────────────────────────────────────────
# `bazel run` executes in the runfiles tree, so a relative path means something else there
# than it does in the shell.  Run them as
#
#     bazel run --run_under="cd $PWD &&" //:unparse_cli -- ...
#
# to keep relative arguments meaning what they say.

# fltk-grammar-lsp entry point: serves fltk's own DSLs from the @fltk// submodule.
# Pure-Python path (like :genparser), so no :native_py dependency is needed.
#
# Named :grammar_lsp rather than :fltk_grammar_lsp because it is the one CLI target that
# predates this set and is documented consumer surface (docs/bazel-consumer-guide.md).
py_binary(
    name = "grammar_lsp",
    srcs = ["fltk/lsp/grammar_cli.py"],
    main = "fltk/lsp/grammar_cli.py",
    python_version = "3.10",
    visibility = ["//visibility:public"],
    deps = [
        ":fltk",
        "@pypi//astor",
        "@pypi//pygls",
        "@pypi//typer",
    ],
)

# fltk-lsp: the generic server, one process per grammar.
py_binary(
