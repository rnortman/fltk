# The grammar-agnostic regex extract/classify tool, used ad hoc against out-of-tree grammars.
py_binary(
    name = "regex_corpus",
    srcs = ["fltk/fegen/regex_corpus.py"],
    main = "fltk/fegen/regex_corpus.py",
