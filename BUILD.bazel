# Fixture inputs tests read from disk.  Separate from _FLTK_DATA (which is the package's own
# runtime data) so a test fixture cannot end up in a consumer's runfiles, and split by corpus
# rather than pooled into the py_test base data: editing one fixture grammar should invalidate
# the targets that read it, not every pytest target in the tree.
filegroup(
    name = "fegen_test_data",
    srcs = glob(
        ["fltk/fegen/test_data/**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//tests:__pkg__"],
