# Smoke target for the stage-0 generator and the out_dir attr together: the two knobs the
# aux-module targets will use.  A build failure here is the stage-0 binary failing to import
# or the out_dir declaration not matching where the generator writes — neither of which the
# analysis tests in //tests/bazel_rules can see, since they never run the action.
generate_parser(
    name = "bootstrap_stage0",
    src = "fltk/fegen/bootstrap.fltkg",
    base_name = "bootstrap_stage0",
    cst_mod_path = "gensub.bootstrap_stage0_cst",
    gen_tool = ":genparser_stage0",
    out_dir = "gensub",
)

# Smoke target for the Python-backend unparser action: the generated unparser module is
# emitted beside the CST and parsers, with a .fltkfmt spec baked in. The analysis tests in
# //tests/bazel_rules assert the argv and the declared outputs but never run the action, so
# a gen-py-unparser that cannot actually generate would only fail here.
generate_parser(
    name = "fixture_py_unparser",
    src = "fltk/fegen/test_data/rust_parser_fixture.fltkg",
    base_name = "fixture_unp",
    cst_mod_path = "gen_py_unparser.fixture_unp_cst",
    format_config = "fltk/fegen/test_data/rust_parser_fixture.fltkfmt",
    out_dir = "gen_py_unparser",
    unparser = True,
)

# Pure-Rust smoke target for the generate_rust_parser macro (python_extension =
# False): verifies FLTK's own Bazel surface for Rust codegen works against a
# fixture grammar, emitting only bootstrap_rust_srcs/cst.rs and
# bootstrap_rust_srcs/parser.rs (no cdylib, no .pyi). Covers FLTK CI independent
# of Clockwork. Uses rust_parser_fixture.fltkg (fully within the Rust backend's
# portable subset) so `bazel build //:bootstrap_rust_srcs` succeeds end-to-end.
generate_rust_parser(
    name = "bootstrap_rust_srcs",
    src = "fltk/fegen/test_data/rust_parser_fixture.fltkg",
    # default cst_mod_path = "super::cst"; python_extension defaults to False
)

# Pure-Rust smoke target for the ast / serde codegen actions (ast.rs + de.rs
# beside cst.rs + parser.rs), over the same fixture grammar the cargo fixture
# crate uses.
generate_rust_parser(
    name = "bootstrap_rust_ast_srcs",
    src = "fltk/fegen/test_data/rust_parser_fixture.fltkg",
    ast = True,
    ast_config = "//tests/rust_parser_fixture:rust_parser_fixture.fltkast",
    goal = "nest_sum",
    serde = True,
)

# Pure-Rust smoke target for the unparser codegen action, with a .fltkfmt spec baked
# in and ast = True so the AST module's unparse_str entry point is generated too. The
# fixture's own .fltkfmt is the same spec the cargo fixture crate bakes, so a spec
# feature the Bazel action mishandles fails here rather than in a consumer's build.
generate_rust_parser(
    name = "bootstrap_rust_unparser_srcs",
    src = "fltk/fegen/test_data/rust_parser_fixture.fltkg",
    ast = True,
    ast_config = "//tests/rust_parser_fixture:rust_parser_fixture.fltkast",
    format_config = "fltk/fegen/test_data/rust_parser_fixture.fltkfmt",
    goal = "nest_sum",
    unparser = True,
)

# Python-extension smoke target for the generate_rust_parser macro
# (python_extension = True) exercising the full Python path — crate assembly +
# rust_shared_library cdylib + abi3 rename + py_library — AND stub-package
# emission (protocol_module + protocol), which no other in-tree target does. This
# is the active regression guard for the stub-dir naming bug: the stub package
# must materialize at bootstrap_native/cst.pyi and bootstrap_native/__init__.pyi
# (named after the macro `name`, i.e. the compiled module). lib_rs omitted: the
# macro generates lib.rs from name="bootstrap_native" via generate_rust_lib.
# Uses rust_parser_fixture.fltkg (fully Rust-compilable) so the full target
# builds end-to-end, not just the stub half.
generate_rust_parser(
    name = "bootstrap_native",
    src = "fltk/fegen/test_data/rust_parser_fixture.fltkg",
    python_extension = True,
    protocol_module = "bootstrap_native.cst_protocol",
    protocol = True,
)

# Compile test for the ast / serde path: a generated module that does not compile, or
# a runtime dep the macro forgets to plumb, fails here rather than in a consumer's build.
# Separate from bootstrap_native so the stub-package regression guard above keeps its
# minimal configuration.
generate_rust_parser(
    name = "bootstrap_ast_native",
    src = "fltk/fegen/test_data/rust_parser_fixture.fltkg",
    ast = True,
    ast_config = "//tests/rust_parser_fixture:rust_parser_fixture.fltkast",
    goal = "nest_sum",
    python_extension = True,
    serde = True,
)

# Compile test for the extension-mode unparser path: the generated lib.rs must declare
# and register `mod unparser;`, the assembly genrule must stage unparser.rs, and the
# cdylib must link fltk-unparser-core. protocol_module is set so the stub package also
# exercises unparser.pyi emission and the `unparser` entry in the __init__.pyi marker.
generate_rust_parser(
    name = "bootstrap_unparser_native",
    src = "fltk/fegen/test_data/rust_parser_fixture.fltkg",
    format_config = "fltk/fegen/test_data/rust_parser_fixture.fltkfmt",
    protocol_module = "bootstrap_unparser_native.cst_protocol",
    python_extension = True,
    unparser = True,
)

# Compile test for the serde-without-ast mode — the pure bring-your-own-structs
# configuration the guide leads with, where de.rs carries no Deserialize impls for
# generated AST types and the crate never links fltk-ast-core. Every other Bazel
# target sets ast = True, so a dep the serde-only crate needs and does not get, or
# a guard that over-refuses this combination, would ship undetected.
generate_rust_parser(
    name = "bootstrap_serde_only_native",
    src = "fltk/fegen/test_data/rust_parser_fixture.fltkg",
    ast_config = "//tests/rust_parser_fixture:rust_parser_fixture.fltkast",
    goal = "nest_sum",
    python_extension = True,
    serde = True,
)

# ── The pytest suite: one target per test file ────────────────────────────────
# Test files that live under fltk/ are declared here rather than in a package of their own: a
# BUILD file under fltk/ would cut this package's fltk/** globs off at that directory, taking
# :fltk_src, :fltk and the lint targets with it.  The files under tests/ get their own package.
#
# The dict is an explicit inventory rather than a glob: a glob would absorb a new file with
# whatever deps the pattern happened to carry, and keep passing when one is deleted.  The macro
# checks it against `glob_pattern` and `deferred` at load time, so a file in none of the three
# fails the build.
