# Every prose doc in the repo, for the uv-retirement gate in //tests.  A glob rather than a
# list so a guide added later is scanned the day it lands — including one filed under a new
# docs/ subdirectory, which is why the docs pattern is recursive.  CHANGELOG.md is excluded:
# it records what past releases did, including the migration onto uv, and is not a recipe
# anyone follows.  docs/adr/ holds untracked working notes and is excluded for the same reason.
# The node_modules carve-outs are the same rule applied to vendored npm trees: those docs are
# third-party, untracked and present only where someone ran `npm install`, so without the
# carve-out the gate's contents — and whether it is red — would differ per checkout.
filegroup(
    name = "repo_docs",
    srcs = glob(
        [
            "*.md",
            "docs/**/*.md",
            "editors/**/*.md",
            "examples/**/*.md",
            "projects/*.md",
        ],
        exclude = [
            "CHANGELOG.md",
            "docs/adr/**",
            "editors/**/node_modules/**",
            "examples/**/node_modules/**",
        ],
    ),
    visibility = ["//tests:__pkg__"],
)

# Tracked tooling config that can carry a command, for the same gate and for the cargo
# retirement gate beside it.  Prose docs are not the only place a retired tool's recipe can
# survive: pyproject.toml is where `[tool.uv]` lived, .bazelrc can name a tool in an
# --action_env or a --run_under, and .claude/settings.json can run one from an agent hook.
filegroup(
    name = "repo_tooling_files",
    srcs = [
        ".bazelrc",
        ".claude/settings.json",
        "pyproject.toml",
    ],
    visibility = ["//tests:__pkg__"],
)

