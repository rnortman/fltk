filegroup(
    name = "lsp_test_data",
    srcs = glob(
        ["fltk/lsp/test_data/**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//tests:__pkg__"],
)

_FLTK_DATA = ["fltk/py.typed"] + glob([
    "fltk/**/*.fltkg",
    "fltk/**/*.fltklsp",
    "fltk/**/*.fltkfmt",
])

# The hand-written half of the package plus the committed seed: what a code generator is
# allowed to import.  Not public — consumers want :fltk, which is this plus the generated
# modules.
py_library(
    name = "fltk_src",
    srcs = glob(
        ["fltk/**/*.py"],
        exclude = _GENERATED_PY,
    ),
    data = _FLTK_DATA,
    imports = ["."],
)

# The generated modules' source paths are excluded from :fltk_src, so nothing here is shadowed
# by, or shadows, a stray in-tree file.
py_library(
    name = "fltk",
    srcs = _GENERATED_PY_TARGETS,
    data = _FLTK_DATA,
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [":fltk_src"],
)

# End-to-end check that the generated modules land at importable package paths: only an actual
# import proves out_dir and cst_mod_path agree with where Python looks.
py_test(
    name = "generated_py_import_test",
    srcs = ["//tests:bazel_generated_py_import_check.py"],
    main = "//tests:bazel_generated_py_import_check.py",
    args = GENERATED_PY_MODULE_ARGS,
    size = "small",
    deps = [":fltk"],
)

# The crate root of fltk._native: generator output — the span-only module wiring, with no
# grammar submodules.  Nothing generated is tracked, so this is the only copy.
generate_rust_lib(
    name = "native_lib_rs",
    module_name = "_native",
    no_cst = True,
    register_span_types = True,
    unknown_span_static = True,
)

# The hand-written modules of the fltk._native crate.  Flat, because the assembly below copies
# by basename; `src/lib.rs` is excluded because that path is the *generated* crate root's, and an
# in-tree copy left behind by an ad-hoc `bazel run //:genparser` would otherwise be copied over
# the build output and compiled in its place — silently, since nothing tracks that file anymore.
_NATIVE_HAND_WRITTEN = glob(
    ["src/*.rs"],
    exclude = ["src/lib.rs"],
)

# rustc resolves `mod span;` relative to the directory holding the crate root, so the generated
# lib.rs and the hand-written modules beside it have to share one directory.  The generated file
# lands in its rule's own subdirectory, hence this flat assembly.  `outs` is derived from the
# same glob rather than listed, so a module added under src/ reaches the crate.
genrule(
    name = "native_crate_srcs",
    srcs = [":native_lib_rs"] + _NATIVE_HAND_WRITTEN,
    outs = ["native_crate/lib.rs"] + [
        "native_crate/" + src[len("src/"):]
        for src in _NATIVE_HAND_WRITTEN
    ],
    cmd = """
        OUTDIR=$$(dirname $(location native_crate/lib.rs))
        for f in $(SRCS); do
            cp $$f $$OUTDIR/$$(basename $$f)
        done
    """,
)

# fltk._native cdylib — the Rust extension that provides the canonical Span/SourceText types.
# Consumers should depend on :native_py (the py_library wrapper) rather than this target directly.
rust_shared_library(
    name = "native",
    srcs = [":native_crate_srcs"],
    crate_name = "fltk_native",
    crate_root = "native_crate/lib.rs",
    # "extension-module" enables pyo3's no-libpython-link mode (required for cdylibs).
    # "python" must be set explicitly: Span/SourceText pyclass registration in
    # fltk-cst-core is gated on #[cfg(feature = "python")] and is compiled out without it.
    # Bazel crate_features do not forward transitively — each must be stated explicitly.
    crate_features = [
        "extension-module",
        "python",
    ],
    edition = "2021",
    version = FLTK_CRATE_VERSION,
    visibility = ["//visibility:public"],
    deps = [
        "//crates/fltk-cst-core",
        "@fltk_crates//:pyo3",
    ],
)

# Rename libfltk_native.so -> fltk/_native.abi3.so so that `import fltk._native` resolves.
# rules_rust produces lib<crate_name>.so; the abi3 suffix is the maturin convention for
# CPython 3.10+ ABI-stable extensions and is what CPython expects for a stable-ABI cdylib.
# Use $(location :native) rather than $< to avoid positional ambiguity if rules_rust
# ever emits additional files alongside the .so (e.g. debug info).
genrule(
    name = "native_so",
    srcs = [":native"],
    outs = ["fltk/_native.abi3.so"],
    cmd = "cp $(location :native) $@",
)

# py_library wrapper: puts fltk/_native.abi3.so on the Python path so that
# `import fltk._native` succeeds in any target that depends on :native_py.
# Consumers may depend on both :fltk and :native_py to get the full runtime.
py_library(
    name = "native_py",
    data = [":native_so"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

